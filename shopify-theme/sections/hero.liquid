<section class="hero" id="hero">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero__image',
          sizes: '100vw',
          widths: '375, 750, 1100, 1500, 1780, 2000'
      }}
    {%- else -%}
      <div class="hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder-svg' }}
      </div>
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content container">
    <div class="hero__content-inner" data-animate="fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="hero__heading">
        {{ section.settings.heading | default: 'Soft Power.<br>Bold Presence.' }}
      </h1>

      <p class="hero__subtext">
        {{ section.settings.subtext | default: 'Luxury redefined through comfort.' }}
      </p>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="btn btn--primary btn--lg hero__cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New Arrivals"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Soft Power.<br>Bold Presence.</p>"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Luxury redefined through comfort."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
