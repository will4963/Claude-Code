{%- comment -%}
  Renders a product card.
  Accepts: product, show_quick_view (boolean, default true)
{%- endcomment -%}

{%- assign show_quick_view = show_quick_view | default: true -%}
{%- assign featured_image = product.featured_image -%}
{%- assign hover_image = product.images[1] -%}

<article class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__media-link" tabindex="-1" aria-hidden="true">
      {%- if featured_image != blank -%}
        {{
          featured_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'product-card__image product-card__image--primary',
            alt: featured_image.alt | default: product.title,
            sizes: '(max-width: 768px) 50vw, 25vw',
            widths: '200, 300, 400, 600, 800'
        }}
        {%- if hover_image != blank -%}
          {{
            hover_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              class: 'product-card__image product-card__image--hover',
              alt: hover_image.alt | default: product.title,
              sizes: '(max-width: 768px) 50vw, 25vw',
              widths: '200, 300, 400, 600, 800'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {%- endif -%}
    </a>

    {%- if product.compare_at_price > product.price -%}
      {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <span class="product-card__badge">-{{ discount_pct }}%</span>
    {%- elsif product.tags contains 'new' -%}
      <span class="product-card__badge product-card__badge--new">New</span>
    {%- endif -%}

    {%- if show_quick_view -%}
      <div class="product-card__actions">
        <button
          class="btn btn--outlined product-card__quickview"
          data-quick-view="{{ product.handle }}"
          aria-label="Quick view {{ product.title }}"
        >
          Quick View
        </button>
        <button
          class="product-card__wishlist"
          aria-label="Add to wishlist"
          data-product-id="{{ product.id }}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-card__price-wrap">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__price product-card__price--sale">{{ product.price | money }}</span>
        <s class="product-card__price product-card__price--compare">{{ product.compare_at_price | money }}</s>
      {%- else -%}
        <span class="product-card__price">{{ product.price | money }}</span>
      {%- endif -%}
    </div>
    {%- if product.available == false -%}
      <p class="product-card__sold-out">Sold Out</p>
    {%- endif -%}
  </div>
</article>
