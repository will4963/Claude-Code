{%- comment -%}
  Renders a star rating.
  Accepts: rating (number 0-5), review_count (integer), show_count (boolean)
{%- endcomment -%}

{%- assign rating = rating | default: 4.8 -%}
{%- assign review_count = review_count | default: 0 -%}
{%- assign show_count = show_count | default: true -%}
{%- assign full_stars = rating | floor -%}
{%- assign remainder = rating | minus: full_stars -%}

<div class="star-rating" aria-label="Rating: {{ rating }} out of 5" role="img">
  <div class="star-rating__stars" aria-hidden="true">
    {%- for i in (1..5) -%}
      {%- if i <= full_stars -%}
        <span class="star star--full">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </span>
      {%- elsif remainder >= 0.5 and i == full_stars | plus: 1 -%}
        <span class="star star--half">
          <svg width="14" height="14" viewBox="0 0 24 24">
            <defs>
              <linearGradient id="half-star-{{ section.id }}-{{ forloop.index }}">
                <stop offset="50%" stop-color="currentColor"/>
                <stop offset="50%" stop-color="transparent"/>
              </linearGradient>
            </defs>
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="url(#half-star-{{ section.id }}-{{ forloop.index }})" stroke="currentColor" stroke-width="0.5"/>
          </svg>
        </span>
      {%- else -%}
        <span class="star star--empty">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <span class="star-rating__score">{{ rating }}</span>
  {%- if show_count and review_count > 0 -%}
    <span class="star-rating__count">({{ review_count }} reviews)</span>
  {%- endif -%}
</div>
